// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma

// Amazon DSP Driver Allocation System
// Generated from plans/data-model.md with user-confirmed adjustments applied.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  DRIVER
  SUPERVISOR
  ACCOUNT_MANAGER
  ADMIN
}

enum WeekDay {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

// User-confirmed: Ciclo 2 / Tarde / Speed are equivalent.
// Speed as an extra shift is represented by ScheduleStatus.SPEED.
enum Cycle {
  CICLO_1 // Manhã
  CICLO_2 // Tarde / Speed
}

enum AvailabilityAnswer {
  SIM // Disponível
  NAO // Indisponível
  CICLO_2 // Disponível apenas no Ciclo 2 / Tarde / Speed
}

enum VehicleType {
  CARGO_VAN
  LARGE_VAN
  PASSEIO
}

// Eligibility for VacancyBlock: which vehicle types a driver must have to be
// assigned to this block. Stored as an array on the block itself (Postgres
// native array) — avoids a join table for a field that holds at most 3 values.
enum VehicleEligibility {
  GNV
  CARGO_VAN
  PASSENGER
}

enum VehicleRestrictionCode {
  GNV
  REFRIGERADOR
  CAPACIDADE_REDUZIDA
  NATURAL_GAS // @deprecated — legacy duplicate of GNV; retained for historical data, not writable
}

enum VacancyStatus {
  RASCUNHO
  PUBLICADA
  FECHADA
}

enum ScheduleStatus {
  SIM // Alocado
  SEM_ESCALA // 7º dia consecutivo / limite atingido
  A_CONFIRMAR // Disponível mas sem vaga suficiente
  NAO // Não informou disponibilidade
  SPEED // Turno extra/especial
  FALTA // Falta no dia
}

enum ScorecardClassification {
  FANTASTIC_PLUS
  FANTASTIC
  GREAT
  FAIR
  POOR
}

// The 5 infraction types defined by the user (2026-08-14). The punishment is
// determined by the TYPE, never by the supervisor. See
// docs/plans/driver-behavior-and-allocation-rules.md §3.1.
enum InfractionType {
  NAO_REVERTER_INSUCESSOS // objetivo — perde 1 vaga
  RECLAMACAO_ASPERA // subjetivo — perde 1 vaga (exige aprovação do gerente)
  FALTAS_RECORRENTES // objetivo — perde 1 vaga
  ABANDONO_ROTA // grave — 1 semana sem vagas
  DESCUMPRIR_REGRAS_AMAZON // misto — perde 1 vaga
}

// Lifecycle of an infraction/punishment.
//   PENDING_APPROVAL — only for RECLAMACAO_ASPERA; waits for account manager.
//   ACTIVE           — punishment is in force (applies to the effective week).
//   FULFILLED        — the driver actually lost the vacancy / served the week.
//   CANCELLED        — account manager rejected the subjective mark.
enum InfractionStatus {
  PENDING_APPROVAL
  ACTIVE
  FULFILLED
  CANCELLED
}

enum DispatchWeekStatus {
  PLANNING
  OPEN
  CLOSED
}

enum AssignmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum AvailabilityApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WhatsAppMessageStatus {
  PENDING
  SCHEDULED
  SENT
  DELIVERED
  READ
  FAILED
}

enum AuditEventType {
  LOGIN
  LOGOUT
  ACCESS_DENIED
  ROLE_CHANGED
  USER_ACTIVATED
  USER_DEACTIVATED
  USER_INVITED
  USER_INVITE_REVOKED
  AVAILABILITY_SUBMITTED
  AVAILABILITY_UPDATED
  VACANCY_PUBLISHED
  VACANCY_UPDATED
  ALLOCATION_RUN
  SCHEDULE_CREATED
  SCHEDULE_UPDATED
  SCHEDULE_PUBLISHED
  WHATSAPP_SENT
  SCORECARD_IMPORTED
  BEHAVIOR_RECORD_CREATED
  BEHAVIOR_RECORD_UPDATED
  INFRACTION_MARKED
  INFRACTION_APPROVED
  INFRACTION_REJECTED
  INFRACTION_FULFILLED
  RECIDIVISM_WARNING
  RECIDIVISM_ESCALATED
  MANUAL_OVERRIDE
  CONSENT_GIVEN
  CONSENT_REVOKED
  VEHICLE_RESTRICTION_UPDATED
  CNH_UPDATED
  CITY_PREFERENCES_UPDATED
  VEHICLE_TYPE_UPDATED
  CNH_COLLECTED
  DRIVER_PROFILE_UPDATED
  DRIVER_PHONE_UPDATED
  DEACTIVATION_REQUEST_CREATED
  DEACTIVATION_REQUEST_APPROVED
  DEACTIVATION_REQUEST_REJECTED
  DEACTIVATION_REQUEST_CANCELLED
}

enum DeactivationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------- Core Entities ----------

model TransportCompany {
  id          String   @id @default(uuid())
  name        String
  legalName   String?
  cnpj        String?  @unique
  amazonDspId String?  @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  regions         Region[]
  users           User[]
  vacancyPrograms VacancyProgram[]
  dispatchWeeks   DispatchWeek[]
  vacancyBlocks   VacancyBlock[]
  performanceImports PerformanceImport[]

  @@map("transport_companies")
}

model Region {
  id                 String   @id @default(uuid())
  transportCompanyId String
  code               String // XSP7, ELP7, DSP5, plus future regions
  name               String
  city               String?
  state              String? // SP, RJ, etc.
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  transportCompany  TransportCompany       @relation(fields: [transportCompanyId], references: [id])
  vacancyPrograms   VacancyProgram[]
  regionPreferences RegionCityPreference[]

  @@unique([transportCompanyId, code])
  @@map("regions")
}

model User {
  id                   String    @id @default(uuid())
  transportCompanyId   String?
  email                String    @unique
  name                 String
  image                String?
  role                 UserRole  @default(DRIVER)
  amazonSub            String?   @unique
  amazonAccessToken    String? // encrypted at application level
  amazonRefreshToken   String? // encrypted at application level
  amazonTokenExpiresAt DateTime?
  emailVerified        DateTime?
  active               Boolean   @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Who deactivated this user (for the "who deactivates determines who can
  // reactivate" rule). Null when the user has never been deactivated.
  deactivatedById   String?
  deactivatedByRole UserRole?

  transportCompany TransportCompany?    @relation(fields: [transportCompanyId], references: [id])
  driverProfile    DriverProfile?
  availabilities   WeeklyAvailability[]
  driverAvailabilities DriverAvailability[]
  schedules        Schedule[]
  whatsAppMessages WhatsAppMessage[]
  auditLogs        AuditLog[]
  allocationRuns   AllocationRun[]
  accounts         Account[]
  sessions         Session[]
  allowedEmails    AllowedEmail[] @relation("InvitedBy")

  // User-confirmed: supervisors mark infractions, account managers approve
  // the subjective type (RECLAMACAO_ASPERA).
  infractionsMarked   DriverInfraction[] @relation("InfractionMarkedBy")
  infractionsApproved DriverInfraction[] @relation("InfractionApprovedBy")

  // User-confirmed: account managers mark favorites manually.
  manualFavoriteOverrides FavoriteDriver[] @relation("FavoriteManualOverrideBy")
  assignedAssignments     DispatchAssignment[] @relation("AssignedByUser")
  availabilityApprovalsReviewed AvailabilityApproval[] @relation("AvailabilityReviewer")
  availabilitiesImported      DriverAvailability[] @relation("AvailabilityImportedBy")

  // Deactivation request relations
  deactivationRequestsAsDriver    DeactivationRequest[] @relation("DeactivationRequestDriver")
  deactivationRequestsAsRequester DeactivationRequest[] @relation("DeactivationRequestRequester")
  deactivationRequestsAsReviewer  DeactivationRequest[] @relation("DeactivationRequestReviewer")

  @@index([email])
  @@index([role, active])
  @@map("users")
}

model DriverProfile {
  id                  String      @id @default(uuid())
  userId              String      @unique
  cpf                 String?     @unique // encrypted at application level
  cpfBlindIndex       String?     @unique // HMAC-SHA256 for deterministic lookup
  phone               String? // encrypted at application level
  phoneFormatted      String? // E.164 + display format
  vehicleType         VehicleType @default(CARGO_VAN)
  transporterId       String? // Amazon Transporter ID
  onboardingCompleted Boolean     @default(false)
  cnhExpiration       DateTime? // CNH expiry date; null = unknown/not set

  // Driver cycle preference (independent from weekly speedAfternoon)
  worksCiclo1         Boolean     @default(false) // Manhã
  worksCiclo2         Boolean     @default(false) // Tarde / Speed

  // Trust flag: manual mark by account managers. Not consumed by allocation yet.
  isTrusted           Boolean     @default(false)

  // WhatsApp group name (free text, max 80 chars enforced at application level)
  whatsappGroup       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleRestrictions VehicleRestriction[]
  regionPreferences   RegionCityPreference[]
  favoriteFlags       FavoriteDriver[]
  infractions         DriverInfraction[]
  driverScores        DriverScore[]
  performanceSnapshots DriverPerformanceSnapshot[]
  assignments         DispatchAssignment[]
  cnhReminders        CnhReminder[]

  @@index([transporterId])
  @@map("driver_profiles")
}

// A CNH-collection email sent to a driver by a supervisor. This is a HISTORY
// table: re-send is allowed, so there is no unique constraint — every send
// appends a row with a timestamp and the actor who triggered it. The
// supervisor sees the most recent collection per driver before charging again.
model CnhReminder {
  id              String   @id @default(uuid())
  driverProfileId String
  cnhExpiration   DateTime // the expiry date this collection refers to
  type            String   @default("CNH_COLLECTED") // CNH_COLLECTED
  sentAt          DateTime @default(now())
  actorId         String? // who triggered the collection (supervisor+)

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@index([driverProfileId])
  @@map("cnh_reminders")
}

model VehicleRestriction {
  id              String                 @id @default(uuid())
  driverProfileId String
  code            VehicleRestrictionCode
  notes           String?
  createdAt       DateTime               @default(now())

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@unique([driverProfileId, code])
  @@map("vehicle_restrictions")
}

model RegionCityPreference {
  id              String   @id @default(uuid())
  driverProfileId String?
  regionId        String?
  city            String?
  priority        Int      @default(1) // 1 = primary
  createdAt       DateTime @default(now())

  driverProfile DriverProfile? @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  region        Region?        @relation(fields: [regionId], references: [id])

  @@index([driverProfileId])
  @@index([regionId])
  @@map("region_city_preferences")
}

// ---------- Availability ----------

model AvailabilityWeek {
  id            String    @id @default(uuid())
  weekKey       String // e.g., WK-31
  year          Int
  weekNumber    Int // ISO/Amazon week number
  opensAt       DateTime
  closesAt      DateTime
  extendedUntil DateTime?
  status        String    @default("OPEN") // OPEN, CLOSED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  days WeeklyAvailability[]

  @@unique([year, weekNumber])
  @@index([weekKey])
  @@map("availability_weeks")
}

model WeeklyAvailability {
  id                 String             @id @default(uuid())
  availabilityWeekId String
  userId             String
  day                WeekDay
  cycle              Cycle              @default(CICLO_1)
  answer             AvailabilityAnswer
  submittedAt        DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  availabilityWeek AvailabilityWeek @relation(fields: [availabilityWeekId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([availabilityWeekId, userId, day, cycle])
  @@index([availabilityWeekId, userId])
  @@index([userId, availabilityWeekId])
  @@map("weekly_availabilities")
}

// Availability imported from the standard XLSX filled by drivers (DA).
// One row per driver/week, with daily booleans covering Sunday-Saturday
// plus vehicle flags and import audit fields.
model DriverAvailability {
  id               String    @id @default(uuid())
  dispatchWeekId   String
  userId           String

  // When the driver filled the form (column A of the XLSX).
  filledAt DateTime?

  // Import audit.
  importedAt   DateTime @default(now())
  importedById String?

  // Vehicle flags (columns E-F).
  hasNaturalGas  Boolean @default(false)
  isPassengerCar Boolean @default(false)

  // Daily availability, Sunday -> Saturday (columns G-M).
  sunAvailable Boolean @default(false)
  monAvailable Boolean @default(false)
  tueAvailable Boolean @default(false)
  wedAvailable Boolean @default(false)
  thuAvailable Boolean @default(false)
  friAvailable Boolean @default(false)
  satAvailable Boolean @default(false)

  // Available for the afternoon/Speed/Ciclo 2 shift (column N).
  speedAfternoon Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispatchWeek DispatchWeek          @relation(fields: [dispatchWeekId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  importedBy   User?                 @relation("AvailabilityImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  approval     AvailabilityApproval?

  @@unique([dispatchWeekId, userId])
  @@index([dispatchWeekId, userId])
  @@index([userId, dispatchWeekId])
  @@map("driver_availabilities")
}

// Tracks drivers who filled the XLSX but are inactive at import time.
// A supervisor/account manager/admin must approve/reject before the
// availability can be used in allocation.
model AvailabilityApproval {
  id String @id @default(uuid())

  driverAvailabilityId String @unique
  status               AvailabilityApprovalStatus @default(PENDING)

  reviewerId String?
  reviewedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driverAvailability DriverAvailability @relation(fields: [driverAvailabilityId], references: [id], onDelete: Cascade)
  reviewer           User?              @relation("AvailabilityReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([reviewerId])
  @@map("availability_approvals")
}

// ---------- Vacancies ----------

model VacancyProgram {
  id                 String        @id @default(uuid())
  transportCompanyId String
  regionId           String
  weekKey            String // WK-XX
  year               Int
  weekNumber         Int
  day                WeekDay
  cycle              Cycle         @default(CICLO_1)
  vehicleCategory    String // e.g., "Small R2.0 BR", "Inside Natural Gas", "Passenger"
  vehicleType        VehicleType? // optional normalized type
  quantity           Int
  status             VacancyStatus @default(RASCUNHO)
  source             String? // MANUAL, AMAZON_IMPORT
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  transportCompany    TransportCompany     @relation(fields: [transportCompanyId], references: [id])
  region              Region               @relation(fields: [regionId], references: [id])
  distributionResults DistributionResult[]

  @@unique([regionId, year, weekNumber, day, cycle, vehicleCategory])
  @@index([weekKey, regionId])
  @@index([regionId, year, weekNumber])
  @@index([status])
  @@map("vacancy_programs")
}

// ---------- Allocation ----------

model AllocationRun {
  id             String    @id @default(uuid())
  weekKey        String
  year           Int
  weekNumber     Int
  regionId       String?
  triggeredById  String
  triggerType    String // AUTO, MANUAL, REEXECUTE
  status         String    @default("RUNNING") // RUNNING, COMPLETED, FAILED
  configSnapshot Json? // JSON copy of rules/weights used
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())

  triggeredBy User                 @relation(fields: [triggeredById], references: [id])
  results     DistributionResult[]
  schedules   Schedule[]

  @@index([weekKey, regionId])
  @@index([status])
  @@map("allocation_runs")
}

model DistributionResult {
  id                    String   @id @default(uuid())
  allocationRunId       String
  vacancyProgramId      String
  driverProfileId       String
  day                   WeekDay
  cycle                 Cycle
  score                 Float    @default(0) // computed priority score
  matchedVehicleType    Boolean  @default(false)
  matchedRegionPref     Boolean  @default(false)
  isFavorite            Boolean  @default(false)
  behaviorPenalty       Float    @default(0)
  consecutiveDaysBefore Int?
  assigned              Boolean  @default(false)
  reason                String? // why assigned or not
  createdAt             DateTime @default(now())

  allocationRun  AllocationRun  @relation(fields: [allocationRunId], references: [id], onDelete: Cascade)
  vacancyProgram VacancyProgram @relation(fields: [vacancyProgramId], references: [id], onDelete: Cascade)

  @@index([allocationRunId, driverProfileId])
  @@index([allocationRunId, vacancyProgramId])
  @@map("distribution_results")
}

// ---------- Schedule / Roster ----------

model Schedule {
  id              String         @id @default(uuid())
  allocationRunId String?
  userId          String
  regionId        String
  weekKey         String
  year            Int
  weekNumber      Int
  day             WeekDay
  cycle           Cycle          @default(CICLO_1)
  status          ScheduleStatus
  vehicleCategory String? // actual vacancy category filled
  overrideById    String? // supervisor who manually changed (day swaps allowed at any time)
  overrideReason  String?
  overrideAt      DateTime?
  publishedAt     DateTime?
  publishedById   String?
  isLocked        Boolean        @default(false) // after WhatsApp send
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  allocationRun AllocationRun? @relation(fields: [allocationRunId], references: [id])
  user          User           @relation(fields: [userId], references: [id])

  auditLogs        AuditLog[]
  whatsappMessages WhatsAppMessage[]

  @@unique([userId, year, weekNumber, day, cycle, regionId])
  @@index([weekKey, regionId])
  @@index([userId, year, weekNumber])
  @@index([status, isLocked])
  @@map("schedules")
}

// ---------- Scorecard ----------

model ScorecardImport {
  id           String    @id @default(uuid())
  weekKey      String
  year         Int
  weekNumber   Int
  fileName     String
  fileUrl      String? // S3/Storage URL
  importedById String?
  status       String    @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  errors       Json?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  driverScores DriverScore[]

  @@index([weekKey])
  @@index([status])
  @@map("scorecard_imports")
}

model DriverScore {
  id                      String                   @id @default(uuid())
  scorecardImportId       String
  driverProfileId         String
  daRank                  Int?
  transporterId           String?
  totalScore              Float?
  delivered               Int?
  dcr                     Float?
  dnrDpmo                 Float?
  contactCompliance       Float?
  scanCompliance          Float?
  whExceptionFlag         Boolean?
  swaOta                  Float?
  swipeToFinishCompliance Float?
  workHourCompliance      Float?
  attrition               Float?
  dspLateCancellationRate Float?
  classification          ScorecardClassification?

  // User-confirmed: favorite flag is now set manually by account managers.
  // This field is kept for reference/import context only.
  isFavorite Boolean @default(false)

  createdAt DateTime @default(now())

  scorecardImport ScorecardImport @relation(fields: [scorecardImportId], references: [id], onDelete: Cascade)
  driverProfile   DriverProfile   @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@unique([scorecardImportId, driverProfileId])
  @@index([driverProfileId, scorecardImportId])
  @@map("driver_scores")
}

// ---------- Performance ----------

model PerformanceImport {
  id                 String    @id @default(uuid())
  dispatchWeekId     String?
  weekKey            String
  year               Int
  weekNumber         Int
  transportCompanyId String
  fileName           String
  importedById       String
  status             String    @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  errors             Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  dispatchWeek     DispatchWeek?               @relation(fields: [dispatchWeekId], references: [id], onDelete: SetNull)
  transportCompany TransportCompany            @relation(fields: [transportCompanyId], references: [id])
  snapshots        DriverPerformanceSnapshot[]

  @@index([dispatchWeekId])
  @@index([weekKey])
  @@index([status])
  @@index([transportCompanyId])
  @@map("performance_imports")
}

model DriverPerformanceSnapshot {
  id                  String                  @id @default(uuid())
  performanceImportId String
  driverProfileId     String?
  transporterId       String
  name                String
  scoreText           String?
  deliveredPackages   Int
  dcr                 Float // 0-1 decimal parsed from percentage
  dnr                 Int
  insucessos          Int                     // rounded integer imported from file
  contactCompliance   Float // 0-1 decimal parsed from percentage
  swipeToFinishCompliance Float // 0-1 decimal parsed from percentage
  whc100              Boolean // "Yes"/1/true -> true
  classification      ScorecardClassification
  createdAt           DateTime                @default(now())

  performanceImport PerformanceImport @relation(fields: [performanceImportId], references: [id], onDelete: Cascade)
  driverProfile     DriverProfile?    @relation(fields: [driverProfileId], references: [id], onDelete: SetNull)

  @@index([performanceImportId])
  @@index([driverProfileId])
  @@index([transporterId])
  @@map("driver_performance_snapshots")
}

// ---------- Behavior & Favorites ----------

model FavoriteDriver {
  id              String  @id @default(uuid())
  driverProfileId String
  weekKey         String
  year            Int
  weekNumber      Int
  isFavorite      Boolean @default(true)

  // User-confirmed: favorites are marked manually by account managers and guarantee +1 weekly slot.
  source             String  @default("MANUAL") // MANUAL
  manualOverrideById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driverProfile    DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  manualOverrideBy User?         @relation("FavoriteManualOverrideBy", fields: [manualOverrideById], references: [id], onDelete: SetNull)

  @@unique([driverProfileId, year, weekNumber])
  @@index([weekKey])
  @@map("favorite_drivers")
}

// A behavior infraction marked by a supervisor. The punishment is derived
// from the TYPE (never chosen by the supervisor). See
// docs/plans/driver-behavior-and-allocation-rules.md §3.
//
// Lifecycle:
//   - RECLAMACAO_ASPERA starts PENDING_APPROVAL and only becomes ACTIVE after
//     an account manager approves it. The other 4 types start ACTIVE.
//   - The punishment applies to the effective week (the week AFTER the one
//     the infraction was marked for).
//   - "Perde N vagas" (LOSE_VACANCY) is only FULFILLED when the driver
//     actually receives at least one vacancy in the effective week; if the
//     driver gets none, the punishment stays ACTIVE and rolls to the next
//     week (it never expires on its own).
//   - "N semanas sem vagas" (NO_VACANCIES_WEEK) is FULFILLED after the driver
//     is excluded for `multiplier` consecutive effective weeks.
//   - Recidivism (a new mark while a punishment is ACTIVE or within
//     RECIDIVISM_WINDOW_WEEKS after fulfillment) doubles the punishment
//     (multiplier = 2) and triggers a warning to the supervisor; if the
//     supervisor does not deactivate, the next distribution cycle escalates
//     the warning to the account managers (see selectInfractionsToEscalate).
model DriverInfraction {
  id               String          @id @default(uuid())
  driverProfileId  String
  type             InfractionType
  observation      String?
  weekKey          String // week the infraction was marked for
  effectiveWeekKey String // week the punishment currently applies to

  // Date range of the current effective week, so the distribution engine can
  // match by overlap regardless of weekKey string format.
  effectiveStartDate DateTime @db.Date
  effectiveEndDate   DateTime @db.Date

  status     InfractionStatus @default(PENDING_APPROVAL)
  multiplier Int              @default(1) // 1 or 2 (recidivism doubles)
  weeksServed Int             @default(0) // for NO_VACANCIES_WEEK

  markedById   String?
  approvedById String?
  approvedAt   DateTime?
  fulfilledAt  DateTime?

  // Recidivism warning / escalation timestamps.
  supervisorNotifiedAt DateTime?
  escalatedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  markedBy      User?         @relation("InfractionMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  approvedBy    User?         @relation("InfractionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([driverProfileId, effectiveStartDate, effectiveEndDate])
  @@index([status])
  @@map("driver_infractions")
}

// ---------- Dispatch / Weekly vacancy planning ----------

model DispatchWeek {
  id          String             @id @default(uuid())
  transportCompanyId String
  weekKey     String             // e.g., WK-31
  year        Int
  weekNumber  Int                // ISO/Amazon week number
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  status      DispatchWeekStatus @default(PLANNING)
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  transportCompany TransportCompany   @relation(fields: [transportCompanyId], references: [id])
  vacancies        Vacancy[]
  driverAvailabilities DriverAvailability[]
  blockDailyVacancies  BlockDailyVacancy[]
  performanceImports   PerformanceImport[]

  @@unique([transportCompanyId, year, weekNumber])
  @@index([weekKey])
  @@map("dispatch_weeks")
}

model Vacancy {
  id              String     @id @default(uuid())
  dispatchWeekId  String
  date            DateTime   @db.Date
  vehicleType     VehicleType
  shiftBlock      String     // free-text shift/block label (e.g., "Manhã", "Tarde")
  quantity        Int
  createdById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  dispatchWeek DispatchWeek       @relation(fields: [dispatchWeekId], references: [id], onDelete: Cascade)
  assignments  DispatchAssignment[]

  @@unique([dispatchWeekId, date, vehicleType, shiftBlock])
  @@index([dispatchWeekId, date])
  @@map("vacancies")
}

// ---------- Vacancy Blocks (manual weekly vacancy planning) ----------

// A configurable block of vacancies per transport company. Each block has a
// name, cycle (1 or 2), eligible vehicle types, and optional shift/escala
// label. The eligibility is stored as a Postgres array so it can be edited
// per-block without a join table.
model VacancyBlock {
  id                   String               @id @default(uuid())
  transportCompanyId   String
  name                 String
  cycle                Int                    // 1 or 2
  eligibleVehicleTypes VehicleEligibility[]   // e.g., [GNV], [CARGO_VAN], [CARGO_VAN, GNV]
  shift                String?                // optional shift/escala label
  active               Boolean                @default(true)
  sortOrder            Int                    @default(0)
  createdById          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  updatedById          String?

  transportCompany TransportCompany    @relation(fields: [transportCompanyId], references: [id], onDelete: Cascade)
  dailyVacancies   BlockDailyVacancy[]

  @@index([transportCompanyId, active, sortOrder])
  @@map("vacancy_blocks")
}

// Daily vacancy count for a specific block within a dispatch week.
// Keyed by (dispatchWeekId, vacancyBlockId, dayOfWeek) where dayOfWeek is
// 0=Sunday … 6=Saturday, matching JavaScript Date.getDay().
model BlockDailyVacancy {
  id             String   @id @default(uuid())
  dispatchWeekId String
  vacancyBlockId String
  dayOfWeek      Int      // 0=Dom, 1=Seg, …, 6=Sáb
  count          Int      @default(0) // >= 0
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedById    String?

  dispatchWeek DispatchWeek @relation(fields: [dispatchWeekId], references: [id], onDelete: Cascade)
  vacancyBlock VacancyBlock @relation(fields: [vacancyBlockId], references: [id], onDelete: Cascade)

  @@unique([dispatchWeekId, vacancyBlockId, dayOfWeek])
  @@index([dispatchWeekId, vacancyBlockId])
  @@index([vacancyBlockId])
  @@map("block_daily_vacancies")
}

model DispatchAssignment {
  id              String          @id @default(uuid())
  vacancyId       String
  driverProfileId String
  assignedAt      DateTime        @default(now())
  assignedByUserId String?
  status          AssignmentStatus @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vacancy       Vacancy       @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  assignedBy    User?         @relation("AssignedByUser", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([vacancyId, driverProfileId])
  @@index([driverProfileId])
  @@map("dispatch_assignments")
}

// ---------- WhatsApp ----------

model WhatsAppMessage {
  id                String                @id @default(uuid())
  userId            String
  scheduleId        String?
  weekKey           String?
  templateName      String?
  body              String                @db.Text
  mediaUrl          String? // generated schedule card image
  externalMessageId String? // Meta message id
  status            WhatsAppMessageStatus @default(PENDING)
  statusHistory     Json? // [{ status, at }]
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedReason      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule? @relation(fields: [scheduleId], references: [id])

  @@index([userId, weekKey])
  @@index([externalMessageId])
  @@index([status])
  @@map("whatsapp_messages")
}

// ---------- NextAuth / Auth.js ----------

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------- Audit ----------

model AuditLog {
  id              String         @id @default(uuid())
  eventType       AuditEventType
  actorId         String? // user who performed the action
  targetUserId    String? // affected user, if any
  scheduleId      String?
  allocationRunId String?
  oldValue        Json?
  newValue        Json?
  justification   String?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime       @default(now())

  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([actorId, createdAt])
  @@index([scheduleId])
  @@index([targetUserId])
  @@map("audit_logs")
}

// ---------- Access Control ----------

model AllowedEmail {
  id          String    @id @default(uuid())
  email       String    @unique
  role        UserRole  @default(DRIVER)
  invitedById String?
  status      String    @default("ACTIVE") // ACTIVE, REVOKED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invitedBy User? @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@map("allowed_emails")
}

// ---------- Deactivation Requests ----------

model DeactivationRequest {
  id              String                      @id @default(uuid())
  driverUserId    String
  requestedById   String
  status          DeactivationRequestStatus   @default(PENDING)
  reason          String?
  reviewerId      String?
  reviewedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  driver          User  @relation("DeactivationRequestDriver", fields: [driverUserId], references: [id], onDelete: Cascade)
  requestedBy     User  @relation("DeactivationRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewer        User? @relation("DeactivationRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([driverUserId])
  @@map("deactivation_requests")
}

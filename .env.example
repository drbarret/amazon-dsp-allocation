# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env no repositório.
#
# Recursos provisionados (desenvolvimento):
# - PostgreSQL: Supabase project
# - Redis: Upstash Redis database
# - Envios: Vercel project environment variables
#
# Solicite os valores reais ao responsável pela infraestrutura ou use
# `npx vercel env pull` após configurar as variáveis no dashboard da Vercel.

# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banco de dados PostgreSQL (Supabase)
# Formato padrão: postgresql://[user]:[password]@[host]:[port]/[db]?schema=public
# Supabase recomenda o transaction pooler para serverless (Next.js/Vercel).
DATABASE_URL="postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?schema=public"

# Redis (Upstash) — usado para cache, sessões e filas
# Upstash fornece uma URL rediss:// com token embutido.
REDIS_URL="rediss://default:[token]@[host]:[port]"

# NextAuth / Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="change-me-to-a-random-string-min-32-chars"

# Login with Amazon (LWA) OAuth2
# Register your app at https://developer.amazon.com/
# Allowed Return URLs: https://<your-domain>/api/auth/callback/amazon
# Allowed Origins: https://<your-domain>
AUTH_AMAZON_ID=""
AUTH_AMAZON_SECRET=""
AUTH_SECRET="change-me-to-a-random-string-min-32-chars"
AUTH_URL=http://localhost:3000

# WhatsApp Business API (Meta)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# AWS / Storage (opcional)
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# Criptografia de dados sensíveis (CPF, telefone)
FIELD_ENCRYPTION_KEY=""
FIELD_BLIND_INDEX_KEY=""

# E-mail (Resend) — cobrança de CNH atualizada e escalonamento de reincidência
# Se RESEND_API_KEY não estiver configurada, o sistema degrada com log claro
# e NÃO envia e-mails (nenhuma quebra). NUNCA commite a chave.
RESEND_API_KEY=""
# Remetente autorizado no domínio do Resend. O domínio (instalog.com.br) precisa
# estar VERIFICADO na conta do Resend para o envio funcionar.
# Padrão: "TRC Brasil <trc-brasil@instalog.com.br>"
EMAIL_FROM=""
# Opcional: redireciona TODOS os e-mails para este endereço (teste). Nunca use
# em produção com endereços reais de motoristas.
EMAIL_TO_OVERRIDE=""
